{
  "name": "ptw-cmms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Industrial Permit to Work (PTW) backend module for CMMS",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "node scripts/install-hooks.js",
    "dev": "npm run --workspace=@ptw/web dev",
    "dev:web": "npm run --workspace=@ptw/web dev",
    "dev:api": "npm run --workspace=@ptw/api dev",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "lint": "npm run --workspaces --if-present lint",
    "build": "npm run --workspace=@ptw/shared build && npm run --workspaces --if-present build",
    "build:api": "npm run --workspace=@ptw/shared build && npm run --workspace=@ptw/api build",
    "build:web": "npm run --workspace=@ptw/shared build && npm run --workspace=@ptw/web build",
    "test": "npm run --workspaces --if-present test",
    "db:migrate": "npm run --workspace=@ptw/api db:migrate",
    "db:seed": "npm run --workspace=@ptw/api db:seed",
    "db:migrate:remote": "npm run --workspace=@ptw/api db:migrate",
    "db:seed:remote": "npm run --workspace=@ptw/api db:seed",
    "smoke:deploy": "node scripts/post-deploy-smoke.js"
  },
  "dependencies": {
    "typescript": "^5.5.4"
  }
}
