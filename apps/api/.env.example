# Server
PORT=4000
NODE_ENV=development

# Database
# Application connects as restricted role (ptw_app_user with REVOKE on audit_log)
DATABASE_URL=postgres://ptw_app_user:ptw_app_pass@localhost:5432/ptw_cmms
# Admin/Owner URL used for executing schema migrations and initial seeding
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ptw_cmms
# Optional: password for ptw_app_user when executing migrations with CREATEROLE privilege
APP_DB_PASSWORD=ptw_app_pass
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ptw_cmms_test

# Authentication & Sessions
JWT_SECRET=super-secure-industrial-ptw-secret-key-min-32-chars-long!
JWT_EXPIRES_IN=8h
COOKIE_NAME=ptw_token
COOKIE_SECRET=cookie-secret-key-industrial-ptw!

# Internal Cron / Sweeper Authentication
SWEEP_SECRET=sweep-secret-cron-token-industrial-ptw!

# Client CORS
CORS_ORIGIN=http://localhost:3000
